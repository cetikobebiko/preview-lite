+#[tauri::command]
+pub async fn search_pdf_text(
+    path: String,
+    query: String,
+    cache_namespace: Option<String>,
+    cache: State<'_, crate::PasswordCache>,
+    search_cache: State<'_, crate::SearchCache>,
+    active_search_id: State<'_, crate::ActiveSearchId>,
+) -> Result<crate::SearchResult, String> {
+    if query.trim().is_empty() {
+        return Ok(crate::SearchResult {
+            matches: vec![],
+            is_cancelled: false,
+            total_matches: 0,
+        });
+    }
+
+    let search_id = active_search_id
+        .0
+        .fetch_add(1, std::sync::atomic::Ordering::SeqCst)
+        + 1;
+    let search_id_arc = active_search_id.0.clone();
+    let password = crate::get_cached_password(&path, &cache);
+
+    let cache_namespace = cache_namespace.unwrap_or_else(|| {
+        let mtime = match std::fs::metadata(&path).and_then(|m| m.modified()) {
+            Ok(t) => t
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap_or_default()
+                .as_nanos(),
+            Err(_) => 0,
+        };
+        format!("legacy:{}:{mtime}", path)
+    });
+    let cache_key = format!("{cache_namespace}:{}", query.to_lowercase());
+
+    {
+        let mut cache_guard = search_cache.0.lock();
+        if let Some(result) = cache_guard.get(&cache_key) {
+            return Ok(result.clone());
+        }
+    }
+
+    let path_clone = path.clone();
+
+    let result = tauri::async_runtime::spawn_blocking(move || {
+        use crate::{BoundingBox, SearchMatch, SearchResult};
+        use unicode_normalization::UnicodeNormalization;
+
+        let span = tracing::Span::current();
+        let _enter = span.enter();
+        let _guard = PDFIUM_MUTEX.lock();
+
+        let pdfium = get_pdfium()?;
+        let doc = open_pdfium_doc(&pdfium, &path_clone, password.as_deref())?;
+
+        let mut matches = Vec::new();
+        let mut global_match_index = 0;
+        let mut is_cancelled = false;
+
+        let pages = doc.pages();
+        let page_count = pages.len();
+
+        let lower_query = query.to_lowercase();
+        let lower_query_norm: String = lower_query.nfkc().collect();
+        let query_chars: Vec<char> = lower_query_norm.chars().collect();
+
+        for page_idx in 0..page_count {
+            if search_id_arc.load(std::sync::atomic::Ordering::SeqCst) != search_id {
+                is_cancelled = true;
+                break;
+            }
+
+            if let Ok(page) = pages.get(page_idx) {
+                if let Ok(text_page) = page.text() {
+                    let page_width = page.width().value;
+                    let page_height = page.height().value;
+
+                    let chars = text_page.chars();
+                    let char_vec: Vec<_> = chars.iter().collect();
+                    if char_vec.is_empty() {
+                        continue;
+                    }
+
+                    let mut norm_text = String::new();
+                    let mut norm_to_orig = Vec::new();
+
+                    for (orig_idx, ch) in char_vec.iter().enumerate() {
+                        let orig_char = ch.unicode_char().unwrap_or(' ').to_string();
+                        let orig_char_lower = orig_char.to_lowercase();
+                        let orig_char_norm: String = orig_char_lower.nfkc().collect();
+
+                        let norm_chars_temp: Vec<char> = orig_char_norm.chars().collect();
+                        for _ in &norm_chars_temp {
+                            norm_to_orig.push(orig_idx);
+                        }
+                        norm_text.push_str(&orig_char_norm);
+                    }
+
+                    let norm_chars: Vec<char> = norm_text.chars().collect();
+                    if query_chars.is_empty() || norm_chars.len() < query_chars.len() {
+                        continue;
+                    }
+
+                    let mut start_idx = 0;
+                    while start_idx + query_chars.len() <= norm_chars.len() {
+                        if search_id_arc.load(std::sync::atomic::Ordering::SeqCst) != search_id {
+                            is_cancelled = true;
+                            break;
+                        }
+
+                        let mut found = true;
+                        for i in 0..query_chars.len() {
+                            if norm_chars[start_idx + i] != query_chars[i] {
+                                found = false;
+                                break;
+                            }
+                        }
+
+                        if found {
+                            let orig_start = norm_to_orig[start_idx];
+                            let orig_end = norm_to_orig[start_idx + query_chars.len() - 1];
+
+                            let snippet_start = orig_start.saturating_sub(40);
+                            let snippet_end = (orig_end + 41).min(char_vec.len());
+                            let mut snippet = String::new();
+                            for ch in &char_vec[snippet_start..snippet_end] {
+                                snippet.push(ch.unicode_char().unwrap_or(' '));
+                            }
+                            let snippet = snippet.replace('\n', " ").replace('\r', "");
+
+                            let mut rects = Vec::new();
+                            let mut current_line_min_x = f32::MAX;
+                            let mut current_line_min_y = f32::MAX;
+                            let mut current_line_max_x = f32::MIN;
+                            let mut current_line_max_y = f32::MIN;
+                            let mut last_y_center: Option<f32> = None;
+                            let threshold = 5.0;
+
+                            for ch_idx in orig_start..=orig_end {
+                                if let Ok(bounds) = char_vec[ch_idx].loose_bounds() {
+                                    let nx1 = bounds.left().value / page_width;
+                                    let nx2 = bounds.right().value / page_width;
+                                    let ny1 = (page_height - bounds.top().value) / page_height;
+                                    let ny2 = (page_height - bounds.bottom().value) / page_height;
+
+                                    let min_x = nx1.min(nx2);
+                                    let max_x = nx1.max(nx2);
+                                    let min_y = ny1.min(ny2);
+                                    let max_y = ny1.max(ny2);
+
+                                    let y_center = (min_y + max_y) / 2.0;
+
+                                    if let Some(lyc) = last_y_center {
+                                        if (y_center - lyc).abs() > (threshold / page_height) {
+                                            if current_line_min_x < current_line_max_x
+                                                && current_line_min_y < current_line_max_y
+                                            {
+                                                rects.push(BoundingBox {
+                                                    x: current_line_min_x,
+                                                    y: current_line_min_y,
+                                                    width: current_line_max_x - current_line_min_x,
+                                                    height: current_line_max_y - current_line_min_y,
+                                                });
+                                            }
+                                            current_line_min_x = f32::MAX;
+                                            current_line_min_y = f32::MAX;
+                                            current_line_max_x = f32::MIN;
+                                            current_line_max_y = f32::MIN;
+                                        }
+                                    }
+
+                                    current_line_min_x = current_line_min_x.min(min_x);
+                                    current_line_min_y = current_line_min_y.min(min_y);
+                                    current_line_max_x = current_line_max_x.max(max_x);
+                                    current_line_max_y = current_line_max_y.max(max_y);
+                                    last_y_center = Some(y_center);
+                                }
+                            }
+
+                            if current_line_min_x < current_line_max_x
+                                && current_line_min_y < current_line_max_y
+                            {
+                                rects.push(BoundingBox {
+                                    x: current_line_min_x,
+                                    y: current_line_min_y,
+                                    width: current_line_max_x - current_line_min_x,
+                                    height: current_line_max_y - current_line_min_y,
+                                });
+                            }
+
+                            matches.push(SearchMatch {
+                                global_match_index,
+                                page_index: page_idx as u32,
+                                rects,
+                                snippet,
+                            });
+                            global_match_index += 1;
+
+                            start_idx += query_chars.len();
+                        } else {
+                            start_idx += 1;
+                        }
+                    }
+                }
+            }
+            if is_cancelled {
+                break;
+            }
+        }
+
+        Ok::<_, String>(SearchResult {
+            total_matches: matches.len(),
+            matches,
+            is_cancelled,
+        })
+    })
+    .await
+    .map_err(|e| crate::error::AppError::Thread(format!("Thread hatası: {}", e)).to_string())??;
+
+    if !result.is_cancelled {
+        let mut cache_guard = search_cache.0.lock();
+        cache_guard.put(cache_key, result.clone());
+    }
+
+    Ok(result)
+}
+
+#[tauri::command]
+pub async fn get_page_text_layout(
+    file_path: String,
+    page_index: u32,
+    cache_namespace: Option<String>,
+    cache: State<'_, PasswordCache>,
+    layout_cache: State<'_, TextLayoutCache>,
+    active_tasks: State<'_, ActiveRenderTasks>,
+) -> Result<Vec<TextLayoutData>, String> {
+    let cache_namespace = cache_namespace.unwrap_or_else(|| {
+        let mtime = match std::fs::metadata(&file_path).and_then(|m| m.modified()) {
+            Ok(t) => t
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap_or_default()
+                .as_nanos(),
+            Err(_) => 0,
+        };
+        format!("legacy:{}:{mtime}", file_path)
+    });
+    let cache_key = format!("{cache_namespace}:{page_index}");
+
+    {
+        let mut lc = layout_cache.0.lock();
+        if let Some(cached_data) = lc.get(&cache_key) {
+            return Ok(cached_data.clone());
+        }
+    }
+
+    let token = CancellationToken::new();
+    let component_id = format!("text_layout_{cache_namespace}_{page_index}");
+    {
+        let mut tasks = active_tasks.0.lock();
+        if let Some(old_token) = tasks.insert(component_id.clone(), token.clone()) {
+            old_token.cancel();
+        }
+    }
+
+    struct TokenCleanup<'a> {
+        tasks: &'a parking_lot::Mutex<HashMap<String, CancellationToken>>,
+        id: String,
+    }
+    impl<'a> Drop for TokenCleanup<'a> {
+        fn drop(&mut self) {
+            let mut lock = self.tasks.lock();
+            lock.remove(&self.id);
+        }
+    }
+    let _cleanup = TokenCleanup {
+        tasks: &active_tasks.0,
+        id: component_id,
+    };
+
+    if token.is_cancelled() {
+        return Err("superseded".to_string());
+    }
+
+    let password = get_cached_password(&file_path, &cache);
+    let cache_key_clone = cache_key.clone();
+    let file_path_clone = file_path.clone();
+
+    let layouts = tauri::async_runtime::spawn_blocking(move || {
+        let span = tracing::Span::current();
+        let _enter = span.enter();
+        let _guard = PDFIUM_MUTEX.lock();
+
+        if token.is_cancelled() {
+            return Err("superseded".to_string());
+        }
+
+        let pdfium = get_pdfium()?;
+        let doc = open_pdfium_doc(&pdfium, &file_path_clone, password.as_deref())?;
+
+        let pages = doc.pages();
+        if page_index >= pages.len() as u32 {
+            return Err(format!("Geçersiz sayfa numarası: {}", page_index));
+        }
+
+        let page = pages
+            .get(page_index as u16)
+            .map_err(|e| format!("Sayfa yüklenemedi: {:?}", e))?;
+
+        let mut layouts = Vec::new();
+
+        if let Ok(text_page) = page.text() {
+            let page_width = page.width().value;
+            let page_height = page.height().value;
+
+            let mut current_word_text = String::with_capacity(50);
+            let mut min_x = f32::MAX;
+            let mut min_y = f32::MAX;
+            let mut max_x = f32::MIN;
+            let mut max_y = f32::MIN;
+
+            let mut prev_char_max_x = f32::MIN;
+            let mut prev_char_min_y = f32::MAX;
+
+            let chars = text_page.chars();
+            let mut char_count = 0;
+
+            for ch in chars.iter() {
+                char_count += 1;
+                if char_count % 100 == 0 && token.is_cancelled() {
+                    return Err("superseded".to_string());
+                }
+
+                let c = ch.unicode_char().unwrap_or(' ');
+
+                let c = match c {
+                    '\u{00A0}' => ' ',
+                    '\u{00AD}' | '\u{200B}' | '\0' => continue,
+                    _ => c,
+                };
+
+                let bounds = match ch.loose_bounds() {
+                    Ok(b) => b,
+                    Err(_) => continue,
+                };
+
+                let ch_min_x = bounds.left().value;
+                let ch_min_y = bounds.bottom().value;
+                let ch_max_x = bounds.right().value;
+                let ch_max_y = bounds.top().value;
+                let ch_width = ch_max_x - ch_min_x;
+                let ch_height = ch_max_y - ch_min_y;
+
+                if ch_width <= 0.0 || ch_height <= 0.0 || ch_min_x.is_nan() || ch_min_y.is_nan() {
+                    continue;
+                }
+
+                let mut is_new_word = false;
+
+                if !current_word_text.is_empty() {
+                    let gap_x = ch_min_x - prev_char_max_x;
+                    let gap_y = (ch_min_y - prev_char_min_y).abs();
+
+                    if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
+                        is_new_word = true;
+                    } else if gap_x > ch_height * 0.35 {
+                        is_new_word = true;
+                    } else if gap_y > ch_height * 0.5 {
+                        is_new_word = true;
+                    }
+                }
+
+                if is_new_word {
+                    if !current_word_text.trim().is_empty() && min_x < max_x && min_y < max_y {
+                        layouts.push(TextLayoutData {
+                            x: min_x / page_width,
+                            y: (page_height - max_y) / page_height,
+                            width: (max_x - min_x) / page_width,
+                            height: (max_y - min_y) / page_height,
+                            text: current_word_text.clone(),
+                        });
+                    }
+                    current_word_text.clear();
+                    min_x = f32::MAX;
+                    min_y = f32::MAX;
+                    max_x = f32::MIN;
+                    max_y = f32::MIN;
+                }
+
+                if c != ' ' && c != '\n' && c != '\r' && c != '\t' {
+                    current_word_text.push(c);
+                    min_x = min_x.min(ch_min_x);
+                    min_y = min_y.min(ch_min_y);
+                    max_x = max_x.max(ch_max_x);
+                    max_y = max_y.max(ch_max_y);
+                }
+
+                prev_char_max_x = ch_max_x;
+                prev_char_min_y = ch_min_y;
+            }
+
+            if !current_word_text.trim().is_empty() && min_x < max_x && min_y < max_y {
+                layouts.push(TextLayoutData {
+                    x: min_x / page_width,
+                    y: (page_height - max_y) / page_height,
+                    width: (max_x - min_x) / page_width,
+                    height: (max_y - min_y) / page_height,
+                    text: current_word_text,
+                });
+            }
+        }
+
+        Ok::<_, String>(layouts)
+    })
+    .await
+    .map_err(|e| crate::error::AppError::Thread(format!("Thread hatası: {}", e)).to_string())??;
+
+    {
+        let mut lc = layout_cache.0.lock();
+        lc.put(cache_key_clone, layouts.clone());
+    }
+
+    Ok(layouts)
+}
diff --git a/src-tauri/src/pdf_engine/subprocess_manager.rs b/src-tauri/src/pdf_engine/subprocess_manager.rs
new file mode 100644
index 0000000..b718bb3
--- /dev/null
+++ b/src-tauri/src/pdf_engine/subprocess_manager.rs
@@ -0,0 +1,102 @@
+use crate::worker::ipc::{WorkerCommand, WorkerResponse};
+use bincode;
+use std::process::Stdio;
+use thiserror::Error;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::process::{Child, ChildStdin, ChildStdout, Command};
+use tokio::time::{timeout, Duration};
+
+#[derive(Error, Debug)]
+pub enum SubprocessError {
+    #[error("IO Error: {0}")]
+    Io(#[from] std::io::Error),
+    #[error("Bincode Error: {0}")]
+    Bincode(#[from] bincode::Error),
+    #[error("Worker crashed or exited")]
+    WorkerCrashed,
+    #[error("Timeout waiting for response (Watchdog killed worker)")]
+    Timeout,
+    #[error("Worker Error: {0}")]
+    Worker(String),
+}
+
+pub struct SubprocessManager {
+    child: Child,
+    stdin: ChildStdin,
+    stdout: ChildStdout,
+}
+
+impl SubprocessManager {
+    pub async fn new() -> Result<Self, SubprocessError> {
+        let exe = std::env::current_exe()?;
+        let mut child = Command::new(exe)
+            .arg("--run-worker")
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .spawn()?;
+
+        let stdin = child.stdin.take().ok_or_else(|| {
+            std::io::Error::new(std::io::ErrorKind::Other, "Failed to open stdin")
+        })?;
+        let stdout = child.stdout.take().ok_or_else(|| {
+            std::io::Error::new(std::io::ErrorKind::Other, "Failed to open stdout")
+        })?;
+
+        Ok(Self {
+            child,
+            stdin,
+            stdout,
+        })
+    }
+
+    pub async fn send_command(
+        &mut self,
+        cmd: &WorkerCommand,
+    ) -> Result<WorkerResponse, SubprocessError> {
+        let data = bincode::serialize(cmd)?;
+        let len = (data.len() as u32).to_le_bytes();
+
+        self.stdin.write_all(&len).await?;
+        self.stdin.write_all(&data).await?;
+        self.stdin.flush().await?;
+
+        // Watchdog with 3 seconds timeout
+        let response_future = async {
+            let mut len_buf = [0u8; 4];
+            self.stdout
+                .read_exact(&mut len_buf)
+                .await
+                .map_err(|_| SubprocessError::WorkerCrashed)?;
+            let len = u32::from_le_bytes(len_buf) as usize;
+
+            let mut data_buf = vec![0u8; len];
+            self.stdout
+                .read_exact(&mut data_buf)
+                .await
+                .map_err(|_| SubprocessError::WorkerCrashed)?;
+
+            let response: WorkerResponse = bincode::deserialize(&data_buf)?;
+            Ok::<WorkerResponse, SubprocessError>(response)
+        };
+
+        match timeout(Duration::from_secs(3), response_future).await {
+            Ok(Ok(response)) => {
+                if let WorkerResponse::Error(e) = &response {
+                    return Err(SubprocessError::Worker(e.clone()));
+                }
+                Ok(response)
+            }
+            Ok(Err(e)) => Err(e),
+            Err(_) => {
+                // Timeout occurred, kill the child to prevent zombie
+                let _ = self.child.kill().await;
+                Err(SubprocessError::Timeout)
+            }
+        }
+    }
+
+    pub async fn kill(&mut self) -> Result<(), std::io::Error> {
+        self.child.kill().await
+    }
+}
