+use pdfium_render::prelude::*;
+use std::path::Path;
+use std::process::Command;
+use tauri::State;
+
+use crate::pdf_engine::{get_cached_password, get_pdfium, open_pdfium_doc};
+use crate::PasswordCache;
+
+#[tauri::command]
+pub fn print_pdf(
+    file_path: String,
+    page_range: Option<Vec<u32>>,
+    cache: State<'_, PasswordCache>,
+) -> Result<(), String> {
+    let password = get_cached_password(&file_path, &cache);
+    print_pdf_with_password(file_path, page_range, password)
+}
+
+pub(crate) fn print_pdf_with_password(
+    file_path: String,
+    page_range: Option<Vec<u32>>,
+    password: Option<String>,
+) -> Result<(), String> {
+    let mut print_path = file_path.clone();
+
+    if let Some(pages) = page_range {
+        if !pages.is_empty() {
+            let pdfium = get_pdfium()?;
+            let src_doc = open_pdfium_doc(&pdfium, &file_path, password.as_deref())?;
+            let mut temp_doc = pdfium
+                .create_new_pdf()
+                .map_err(|e| format!("Geçici PDF oluşturulamadı: {:?}", e))?;
+
+            let mut dest_index = 0;
+            for page_index in pages {
+                temp_doc
+                    .pages_mut()
+                    .copy_page_from_document(&src_doc, page_index as u16, dest_index)
+                    .map_err(|e| format!("Sayfa kopyalama hatası: {:?}", e))?;
+                dest_index += 1;
+            }
+
+            let temp_name = format!(
+                "print_{}.pdf",
+                std::time::SystemTime::now()
+                    .duration_since(std::time::UNIX_EPOCH)
+                    .unwrap()
+                    .as_millis()
+            );
+            let temp_file = std::env::temp_dir().join(temp_name);
+            temp_doc
+                .save_to_file(&temp_file)
+                .map_err(|e| format!("Geçici dosya kaydedilemedi: {:?}", e))?;
+
+            print_path = temp_file.to_string_lossy().to_string();
+        }
+    }
+
+    #[cfg(target_os = "macos")]
+    {
+        let status = Command::new("lpr")
+            .arg(&print_path)
+            .status()
+            .map_err(|e| format!("Yazdırma komutu çalıştırılamadı: {}", e))?;
+        if !status.success() {
+            return Err("Yazdırma işlemi başarısız oldu".to_string());
+        }
+    }
+
+    #[cfg(target_os = "linux")]
+    {
+        let status = Command::new("lp")
+            .arg(&print_path)
+            .status()
+            .map_err(|e| format!("Yazdırma komutu çalıştırılamadı: {}", e))?;
+        if !status.success() {
+            return Err("Yazdırma işlemi başarısız oldu".to_string());
+        }
+    }
+
+    #[cfg(target_os = "windows")]
+    {
+        let status = Command::new("powershell")
+            .args(&[
+                "-Command",
+                &format!("Start-Process -FilePath \"{}\" -Verb Print", print_path),
+            ])
+            .status()
+            .map_err(|e| format!("Yazdırma komutu çalıştırılamadı: {}", e))?;
+        if !status.success() {
+            return Err("Yazdırma işlemi başarısız oldu".to_string());
+        }
+    }
+
+    Ok(())
+}
+
+#[tauri::command]
+pub fn export_pages_as_images(
+    file_path: String,
+    pages: Vec<u32>,
+    output_dir: String,
+    format: String,
+    dpi: f32,
+    cache: State<'_, PasswordCache>,
+) -> Result<Vec<String>, String> {
+    let password = get_cached_password(&file_path, &cache);
+    export_pages_as_images_with_password(file_path, pages, output_dir, format, dpi, password)
+}
+
+pub(crate) fn export_pages_as_images_with_password(
+    file_path: String,
+    pages: Vec<u32>,
+    output_dir: String,
+    format: String,
+    dpi: f32,
+    password: Option<String>,
+) -> Result<Vec<String>, String> {
+    let pdfium = get_pdfium()?;
+    let document = open_pdfium_doc(&pdfium, &file_path, password.as_deref())?;
+
+    let mut generated_files = Vec::new();
+    let doc_pages = document.pages();
+
+    for page_idx in pages {
+        if page_idx >= doc_pages.len() as u32 {
+            continue;
+        }
+
+        let page = doc_pages
+            .get(page_idx as u16)
+            .map_err(|e| format!("Sayfa {} yüklenemedi: {:?}", page_idx, e))?;
+
+        let target_width = (page.width().value * (dpi / 72.0)) as i32;
+        let render_config = PdfRenderConfig::new().set_target_width(target_width);
+
+        let bitmap = page
+            .render_with_config(&render_config)
+            .map_err(|e| format!("Sayfa render etme hatası: {:?}", e))?;
+
+        let img = bitmap.as_image();
+
+        let ext = if format.to_lowercase() == "jpeg" {
+            "jpg"
+        } else {
+            "png"
+        };
+        let out_path = Path::new(&output_dir).join(format!("sayfa_{}.{}", page_idx + 1, ext));
+
+        img.save(&out_path)
+            .map_err(|e| format!("Görsel kaydedilemedi: {}", e))?;
+
+        generated_files.push(out_path.to_string_lossy().to_string());
+    }
+
+    Ok(generated_files)
+}
+
+#[tauri::command]
+pub fn export_text_content(
+    file_path: String,
+    pages: Vec<u32>,
+    format: String,
+    cache: State<'_, PasswordCache>,
+) -> Result<String, String> {
+    let password = get_cached_password(&file_path, &cache);
+    export_text_content_with_password(file_path, pages, format, password)
+}
+
+pub(crate) fn export_text_content_with_password(
+    file_path: String,
+    pages: Vec<u32>,
+    format: String,
+    password: Option<String>,
+) -> Result<String, String> {
+    let pdfium = get_pdfium()?;
+    let document = open_pdfium_doc(&pdfium, &file_path, password.as_deref())?;
+
+    let mut out_text = String::new();
+    let is_md = format.to_lowercase() == "markdown";
+    let doc_pages = document.pages();
+
+    for page_idx in pages {
+        if page_idx >= doc_pages.len() as u32 {
+            continue;
+        }
+
+        let page = doc_pages
+            .get(page_idx as u16)
+            .map_err(|e| format!("Sayfa {} yüklenemedi: {:?}", page_idx, e))?;
+
+        let page_text = page.text().map(|t| t.all()).unwrap_or_default();
+
+        if is_md {
+            out_text.push_str(&format!("\n## Sayfa {}\n\n", page_idx + 1));
+        } else {
+            out_text.push_str(&format!("\n--- Sayfa {} ---\n\n", page_idx + 1));
+        }
+
+        out_text.push_str(&page_text);
+    }
+
+    Ok(out_text)
+}
