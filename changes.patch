@@ -0,0 +1,58 @@
+<script>
+  import { onMount } from "svelte";
+  import { getFormFields, updateFormField } from "../pdfState.js";
+
+  export let filePath = "";
+  export let pageIndex = 0;
+  export let scale = 1.0;
+
+  let fields = [];
+
+  onMount(async () => {
+    try {
+      const allFields = await getFormFields(filePath);
+      // Sadece bu sayfanın alanlarını filtrele
+      fields = allFields.filter(f => f.page_index === pageIndex);
+    } catch (e) {
+      console.warn("Form field okuma desteklenmiyor veya hata:", e);
+    }
+  });
+
+  async function handleFieldChange(id, newValue) {
+    try {
+      await updateFormField(filePath, id, newValue);
+    } catch(e) {
+      console.error(e);
+    }
+  }
+</script>
+
+<div class="form-layer" style="transform: scale({scale}); transform-origin: top left;">
+  {#each fields as field}
+    <div class="form-field-proxy">
+      <input type="text" value={field.value} on:change={(e) => handleFieldChange(field.id, e.target.value)} />
+    </div>
+  {/each}
+</div>
+
+<style>
+  .form-layer {
+    position: absolute;
+    top: 0;
+    left: 0;
+    width: 100%;
