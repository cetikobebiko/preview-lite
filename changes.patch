+use preview_alternative_lib::pdf_engine::subprocess_manager::SubprocessManager;
+use preview_alternative_lib::worker::ipc::WorkerCommand;
+use std::fs;
+use std::path::PathBuf;
+
+#[tokio::test]
+async fn test_fuzzer_crashes() {
+    let artifacts_dir = PathBuf::from("fuzz/artifacts/pdfium_lifecycle");
+    if !artifacts_dir.exists() {
+        println!("No fuzzing artifacts found. Skipping regression tests.");
+        return;
+    }
+
+    let entries = match fs::read_dir(&artifacts_dir) {
+        Ok(e) => e,
+        Err(_) => return,
+    };
+
+    for entry in entries {
+        if let Ok(entry) = entry {
+            let path = entry.path();
+            if path.is_file() {
+                println!("Testing artifact: {:?}", path);
+                let mut manager = match SubprocessManager::new().await {
+                    Ok(m) => m,
+                    Err(e) => panic!("Failed to start SubprocessManager: {:?}", e),
+                };
+
+                let cmd = WorkerCommand::LoadDocument {
+                    path: path.to_string_lossy().to_string(),
+                    password: None,
+                };
+
+                let result = manager.send_command(&cmd).await;
+                // It is acceptable if it returns an Error or a Timeout.
+                // What matters is that the test itself doesn't crash (Main process survives).
+                println!("Result for {:?}: {:?}", path, result);
+            }
+        }
+    }
+}
