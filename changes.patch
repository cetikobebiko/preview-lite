+pub async fn get_pdf_outline(
+    file_path: String,
+    cache: State<'_, PasswordCache>,
+) -> Result<Vec<OutlineNode>, String> {
+    let password = get_cached_password(&file_path, &cache);
+    tauri::async_runtime::spawn_blocking(move || {
+        let span = tracing::Span::current();
+        let _enter = span.enter();
+        let _guard = PDFIUM_MUTEX.lock();
+        let pdfium = get_pdfium()?;
+        let doc = open_pdfium_doc(&pdfium, &file_path, password.as_deref())?;
+
+        let mut nodes = Vec::new();
+        let bookmarks = doc.bookmarks();
+        let mut current = bookmarks.root();
+        while let Some(bm) = current {
+            nodes.push(build_pdfium_bookmarks(&bm));
+            current = bm.next_sibling();
+        }
+        Ok(nodes)
+    })
+    .await
+    .map_err(|e| crate::error::AppError::Thread(format!("Thread hatası: {}", e)).to_string())?
+}
