+use crate::get_pdfium;
+use rusty_tesseract::{Args, Image};
+use serde::{Deserialize, Serialize};
+use tauri::AppHandle;
+#[derive(Serialize, Deserialize, Debug)]
+pub struct OcrWord {
+    pub text: String,
+    pub x: i32,
+    pub y: i32,
+    pub width: i32,
+    pub height: i32,
+    pub confidence: f32,
+}
+
+#[derive(Serialize, Deserialize, Debug)]
+pub struct OcrPageResult {
+    pub words: Vec<OcrWord>,
+}
+
+#[tauri::command]
+pub fn detect_scanned_page(file_path: String, page_index: u32) -> Result<bool, String> {
+    let pdfium = get_pdfium().map_err(|e| e.to_string())?;
+    // Şifreli dosyalar için password parametresi None geçiliyor (şimdilik)
+    let document = pdfium
+        .load_pdf_from_file(&file_path, None)
+        .map_err(|e| e.to_string())?;
+    let pages = document.pages();
+    let page = pages.get(page_index as u16).map_err(|e| e.to_string())?;
+
+    // Sayfanın metnini çıkar
+    let text = page.text().map_err(|e| e.to_string())?.all();
+    let text_len = text.trim().len();
+
+    // Eğer 20 karakterden daha az seçilebilir metin varsa, sayfa görsel (scanned) kabul edilebilir
+    if text_len < 20 {
+        Ok(true)
+    } else {
+        Ok(false)
+    }
+}
+
+#[tauri::command]
+pub fn get_available_ocr_languages() -> Result<Vec<String>, String> {
+    let langs = rusty_tesseract::get_tesseract_langs()
+        .map_err(|e| format!("Tesseract bulunamadı: {}", e))?;
+    Ok(langs)
+}
+
+#[tauri::command]
+pub fn run_ocr_on_page(
+    file_path: String,
+    page_index: u32,
+    lang: String,
+) -> Result<OcrPageResult, String> {
+    let pdfium = get_pdfium().map_err(|e| e.to_string())?;
+    let document = pdfium
+        .load_pdf_from_file(&file_path, None)
+        .map_err(|e| e.to_string())?;
+    let pages = document.pages();
+    let page = pages.get(page_index as u16).map_err(|e| e.to_string())?;
+
+    // Sayfayı yüksek çözünürlüklü (2.0 scale / 144 DPI) renderla
+    use pdfium_render::prelude::*;
+    let render_config =
+        PdfRenderConfig::new().set_target_width(((page.width().value * 2.0) as u16).into());
+    let img = page
+        .render_with_config(&render_config)
+        .map_err(|e| e.to_string())?
+        .as_image();
+
+    let tesseract_img = Image::from_dynamic_image(&img).map_err(|e| e.to_string())?;
+
+    let args = Args {
+        lang: lang,
+        ..Default::default()
+    };
+
+    let ocr_output =
+        rusty_tesseract::image_to_data(&tesseract_img, &args).map_err(|e| e.to_string())?;
+    let mut words = Vec::new();
+
+    for record in ocr_output.data {
+        if record.conf >= 0.0 && !record.text.trim().is_empty() {
+            words.push(OcrWord {
+                text: record.text,
+                x: record.left,
+                y: record.top,
+                width: record.width,
+                height: record.height,
+                confidence: record.conf as f32,
+            });
+        }
+    }
+
+    Ok(OcrPageResult { words })
+}
+
+#[tauri::command]
+pub fn export_as_searchable_pdf(
+    _app_handle: AppHandle,
+    _file_path: String,
+    _output_path: String,
+    _lang: String,
+) -> Result<(), String> {
+    Err("Çok sayfalı aranabilir PDF üretimi henüz desteklenmiyor. Lütfen OCR katmanını arayüzden kullanınız.".into())
+}
