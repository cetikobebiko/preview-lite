+async fn render_viewer_rgba(
+    path: String,
+    page_index: u32,
+    sizing: ViewerRenderSizing,
+    rotation: i32,
+    password: Option<String>,
+    token: CancellationToken,
+) -> Result<RenderedPage, String> {
+    tauri::async_runtime::spawn_blocking(move || {
+        if token.is_cancelled() {
+            return Err("render_cancelled".to_string());
+        }
+
+        let _guard = PDFIUM_MUTEX.lock();
+        if token.is_cancelled() {
+            return Err("render_cancelled".to_string());
+        }
+
+        let pdfium = get_pdfium()?;
+        let document = open_pdfium_doc(&pdfium, &path, password.as_deref())?;
+        let pages = document.pages();
+        if page_index >= pages.len() as u32 {
+            return Err(format!("Geçersiz sayfa numarası: {}", page_index));
+        }
+        let page = pages
+            .get(page_index as u16)
+            .map_err(|error| format!("Sayfa {} alınamadı: {:?}", page_index, error))?;
+
+        let target_width = match sizing {
+            ViewerRenderSizing::Scale(scale) => {
+                let width = page.width().value as f64 * scale;
+                if !width.is_finite() || width < 1.0 || width > MAX_PIXEL_DIMENSION as f64 {
+                    return Err("render_invalid_dimensions".to_string());
+                }
+                width as u32
+            }
+            ViewerRenderSizing::TargetWidth(width) => width,
+        };
+        let page_width = page.width().value as f64;
+        let page_height = page.height().value as f64;
+        if page_width <= 0.0 || page_height <= 0.0 {
+            return Err("render_invalid_dimensions".to_string());
+        }
+        let estimated_height =
+            ((target_width as f64 * page_height / page_width).ceil() as u32).max(1);
+        let (estimated_width, estimated_height) = if rotation == 90 || rotation == 270 {
+            (estimated_height, target_width)
+        } else {
+            (target_width, estimated_height)
+        };
+        checked_rgba_len(estimated_width, estimated_height)?;
+
+        if token.is_cancelled() {
+            return Err("render_cancelled".to_string());
+        }
+
+        let pdf_rotation = pdf_rotation(rotation)?;
+        let render_config = PdfRenderConfig::new()
+            .set_target_width(target_width as i32)
+            .rotate(pdf_rotation, true)
+            .set_clear_color(PdfColor::WHITE);
+        let _pdfium_span = tracing::info_span!(target: "pdfium_ffi", "pdfium_render").entered();
+        let bitmap = page
+            .render_with_config(&render_config)
+            .map_err(|error| format!("Sayfa render etme hatası: {:?}", error))?;
+
+        if token.is_cancelled() {
+            return Err("render_cancelled".to_string());
+        }
+
+        let width = bitmap.width() as u32;
+        let height = bitmap.height() as u32;
+        let expected = checked_rgba_len(width, height)?;
+        let bgra = bitmap.as_raw_bytes();
+        if bgra.len() != expected {
+            return Err("render_invalid_rgba_payload".to_string());
+        }
+
+        let _rgba_span = tracing::info_span!("rgba_conversion").entered();
+        let mut rgba = vec![0; expected];
+        for (source, target) in bgra.chunks_exact(4).zip(rgba.chunks_exact_mut(4)) {
+            target[0] = source[2];
+            target[1] = source[1];
+            target[2] = source[0];
+            target[3] = source[3];
+        }
+        Ok(RenderedPage {
+            width,
+            height,
+            data: rgba,
+        })
+    })
+    .await
+    .map_err(|error| format!("Thread hatası: {}", error))?
+}
+
+fn validate_scale(scale: f64) -> Result<(), String> {
+    if !scale.is_finite() || scale <= 0.0 || scale > MAX_SCALE {
+        return Err("render_invalid_scale".to_string());
+    }
+    Ok(())
+}
+
+fn validate_target_width(target_width: u32) -> Result<(), String> {
+    if target_width == 0 || target_width > MAX_PIXEL_DIMENSION {
+        return Err("render_invalid_target_width".to_string());
+    }
+    Ok(())
+}
+
+fn validate_rotation(rotation: i32) -> Result<(), String> {
+    pdf_rotation(rotation).map(|_| ())
+}
