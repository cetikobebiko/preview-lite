+#[derive(Clone, Copy)]
+enum ViewerRenderSizing {
+    Scale(f64),
+    TargetWidth(u32),
+}
+
+impl ViewerRenderSizing {
+    fn key(self) -> RenderSizingKey {
+        match self {
+            Self::Scale(scale) => RenderSizingKey::ScaleBits(scale.to_bits()),
+            Self::TargetWidth(width) => RenderSizingKey::TargetWidth(width),
+        }
+    }
+}
