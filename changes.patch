+fn build_pdfium_bookmarks<'a>(bookmark: &PdfBookmark<'a>) -> OutlineNode {
+    let title = bookmark.title().unwrap_or_else(|| "Untitled".to_string());
+    let page_index = bookmark
+        .destination()
+        .and_then(|dest| dest.page_index().ok())
+        .map(|idx| idx as u32)
+        .unwrap_or(0);
+
+    let mut children = Vec::new();
+    let mut current_child = bookmark.first_child();
+    while let Some(child) = current_child {
+        children.push(build_pdfium_bookmarks(&child));
+        current_child = child.next_sibling();
+    }
+
+    OutlineNode {
+        title,
+        page_index,
+        children,
+    }
+}
