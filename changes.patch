+#[tauri::command]
+pub async fn build_semantic_index(
+    file_path: String,
+    chunk_size: usize,
+    chunk_overlap: usize,
+    ollama_url: String,
+    embed_model: String,
+    store: State<'_, VectorStore>,
+) -> Result<(), String> {
+    // Check if already indexed
+    {
+        let st = store.0.read();
+        if st.contains_key(&file_path) {
+            return Ok(()); // Already indexed
+        }
+    }
+
+    // PDF okuma işlemini senkron olarak tamamla ve PdfDocument objesini serbest bırak
+    let mut page_texts: Vec<(u32, String)> = Vec::new();
+    {
+        let pdfium = get_pdfium().map_err(|e| e.to_string())?;
+        let document = pdfium
+            .load_pdf_from_file(&file_path, None)
+            .map_err(|e| e.to_string())?;
+        let pages = document.pages();
+        for (i, page) in pages.iter().enumerate() {
+            if let Ok(text) = page.text() {
+                page_texts.push((i as u32, text.all()));
+            }
+        }
+    } // `document` ve `pdfium` burada drop olur (Send trait hatasını çözer).
+
+    let mut chunks = Vec::new();
+    let client = Client::new();
+
+    for (page_index, text) in page_texts {
+        if text.trim().is_empty() {
+            continue;
+        }
+
+        let chars: Vec<char> = text.chars().collect();
+        let mut start = 0;
+        while start < chars.len() {
+            let end = std::cmp::min(start + chunk_size, chars.len());
+            let chunk_str: String = chars[start..end].iter().collect();
+
+            if chunk_str.trim().len() > 10 {
+                // Embedding hesapla (Burası async ve await)
+                if let Ok(embedding) =
+                    get_embedding(&client, &ollama_url, &embed_model, &chunk_str).await
+                {
+                    chunks.push(ChunkData {
+                        text: chunk_str,
+                        page_index,
+                        embedding,
+                    });
+                }
+            }
+            start += chunk_size - chunk_overlap;
+        }
+    }
+
+    // Index'i kaydet
+    let mut st = store.0.write();
+    st.insert(file_path, chunks);
+
+    Ok(())
+}
+
+#[tauri::command]
+pub async fn semantic_search(
+    file_path: String,
+    query: String,
+    top_k: usize,
+    ollama_url: String,
+    embed_model: String,
+    store: State<'_, VectorStore>,
+) -> Result<Vec<SearchResultChunk>, String> {
+    let client = Client::new();
+    let query_embed = get_embedding(&client, &ollama_url, &embed_model, &query).await?;
+
+    let st = store.0.read();
+    let chunks = st.get(&file_path).ok_or("Belge henüz indekslenmedi")?;
+
+    let mut results: Vec<SearchResultChunk> = chunks
+        .iter()
+        .map(|c| {
+            let score = cosine_similarity(&query_embed, &c.embedding);
+            SearchResultChunk {
+                text: c.text.clone(),
+                page_index: c.page_index,
+                score,
+            }
+        })
+        .collect();
+
+    // Sort by score descending
+    results.sort_by(|a, b| {
+        b.score
+            .partial_cmp(&a.score)
+            .unwrap_or(std::cmp::Ordering::Equal)
+    });
+
+    // Top K
+    results.truncate(top_k);
+
+    Ok(results)
+}
