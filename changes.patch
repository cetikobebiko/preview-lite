diff --git a/src/components/TagTreeExplorer.svelte b/src/components/TagTreeExplorer.svelte
new file mode 100644
index 0000000..ab3ce3d
--- /dev/null
+++ b/src/components/TagTreeExplorer.svelte
@@ -0,0 +1,115 @@
+<script>
+    import { createEventDispatcher } from 'svelte';
+    const dispatch = createEventDispatcher();
+    
+    export let node;
+    export let isRoot = false;
+    export let level = 0;
+    export let canReorder = false;
+    
+    let isExpanded = true;
+    
+    function toggleExpand() {
+        isExpanded = !isExpanded;
+    }
+    
+    function handleDragStart(event) {
+        if (isRoot || !canReorder) return;
+        event.dataTransfer.setData('text/plain', node.id);
+        event.dataTransfer.effectAllowed = 'move';
+        event.target.classList.add('opacity-50');
+    }
+    
+    function handleDragEnd(event) {
+        event.target.classList.remove('opacity-50');
+    }
+    
+    function handleDragOver(event) {
+        if (isRoot || !canReorder) return;
+        event.preventDefault();
+        event.dataTransfer.dropEffect = 'move';
+        event.currentTarget.classList.add('bg-blue-500/20');
+    }
+    
+    function handleDragLeave(event) {
+        if (isRoot || !canReorder) return;
+        event.currentTarget.classList.remove('bg-blue-500/20');
+    }
+    
+    function handleDrop(event) {
+        if (isRoot || !canReorder) return;
+        event.preventDefault();
+        event.currentTarget.classList.remove('bg-blue-500/20');
+        const draggedId = event.dataTransfer.getData('text/plain');
+        if (draggedId && draggedId !== node.id) {
+            dispatch('nodeReorder', { draggedId, targetId: node.id });
+        }
+    }
+    
+    function selectNode() {
+        dispatch('nodeSelected', node);
+    }
+    
+    function forwardNodeSelected(event) {
+        dispatch('nodeSelected', event.detail);
+    }
+    
+    function forwardNodeReorder(event) {
+        dispatch('nodeReorder', event.detail);
+    }
+</script>
+
+<div class="tag-tree-node select-none" style="margin-left: {isRoot ? 0 : 16}px;">
+    <div 
+        class="flex items-center py-1 px-2 rounded hover:bg-white/10 transition-colors cursor-pointer border border-transparent"
+        draggable={!isRoot && canReorder}
+        on:dragstart={handleDragStart}
+        on:dragend={handleDragEnd}
+        on:dragover={handleDragOver}
+        on:dragleave={handleDragLeave}
+        on:drop={handleDrop}
+        on:click|stopPropagation={selectNode}
+    >
+        {#if node.children && node.children.length > 0}
+            <button class="w-4 h-4 mr-1 text-gray-400 hover:text-white" on:click|stopPropagation={toggleExpand}>
+                {isExpanded ? '▼' : '▶'}
+            </button>
+        {:else}
+            <div class="w-4 h-4 mr-1"></div>
+        {/if}
+        
+        <span class="px-1.5 py-0.5 text-xs font-mono rounded bg-blue-500/20 text-blue-400 mr-2 border border-blue-500/30">
+            {node.tag_type}
+        </span>
+        
+        <span class="text-sm text-gray-300 truncate flex-1">
+            {#if node.alt_text}
+                <span class="text-green-400 italic text-xs mr-1" title="Alt Text">Alt: {node.alt_text}</span>
+            {/if}
+            {#if node.language}
+                <span class="text-yellow-400 text-xs mr-1" title="Language">[{node.language}]</span>
+            {/if}
+            <span class="text-gray-500 text-xs">#{node.id}</span>
+        </span>
+    </div>
+    
+    {#if isExpanded && node.children && node.children.length > 0}
+        <div class="children-container border-l border-white/10 ml-2">
+            {#each node.children as child (child.id)}
+                <svelte:self 
+                    node={child} 
+                    level={level + 1}
+                    {canReorder}
+                    on:nodeSelected={forwardNodeSelected}
+                    on:nodeReorder={forwardNodeReorder}
+                />
+            {/each}
+        </div>
+    {/if}
+</div>
+
+<style>
+    .tag-tree-node {
+        position: relative;
+    }
+</style>
diff --git a/src/components/Thumbnail.svelte b/src/components/Thumbnail.svelte
new file mode 100644
index 0000000..2000d56
--- /dev/null
+++ b/src/components/Thumbnail.svelte
@@ -0,0 +1,217 @@
+<script>
+  import { getContext, onMount } from "svelte";
+  import {
+    cancelRenderRequest,
+    renderThumbnail,
+  } from "../services/backend/viewer.js";
+  import {
+    RENDER_SESSION_CONTEXT,
+    requireActiveRenderSession,
+  } from "../services/renderSession.js";
+  import { paintBufferToCanvas } from "../utils/canvasUtils.js";
+  import {
+    createRenderRequestCoordinator,
+    isExpectedRenderCancellation,
+    validateRenderResponse,
+  } from "../utils/renderRequestCoordinator.js";
+
+  let {
+    filePath = "",
+    pageIndex = 0,
+    isActive = false,
+    onSelect = () => {},
+  } = $props();
+
+  const renderSession = getContext(RENDER_SESSION_CONTEXT);
+  const coordinator = createRenderRequestCoordinator({
+    scope: "sidebar_thumbnail",
+    cancel: (request) => cancelRenderRequest({
+      path: request.path,
+      documentId: request.documentId,
+      pageIndex: request.pageIndex,
+      generation: request.generation,
+      requestId: request.requestId,
+      scope: request.scope,
+    }),
+  });
+
+  let container = $state();
+  let canvas = $state();
+  let isVisible = $state(false);
+  let loading = $state(false);
+  let loadedKey = $state("");
+  let observedSourceKey = $state("");
+  let mounted = $state(false);
+
+  function measuredTargetWidth() {
+    const cssWidth = container?.getBoundingClientRect?.().width || container?.clientWidth || 0;
+    if (!Number.isFinite(cssWidth) || cssWidth <= 0) return 0;
+    const dpr = Math.min(window.devicePixelRatio || 1, 2);
+    return Math.max(1, Math.min(16_384, Math.round(cssWidth * dpr)));
+  }
+
+  function releaseCanvas() {
+    if (!canvas) return;
+    canvas.width = 0;
+    canvas.height = 0;
+  }
+
+  onMount(() => {
+    observedSourceKey = `${filePath}:${pageIndex}`;
+    mounted = true;
+    const observer = new IntersectionObserver((entries) => {
+      isVisible = entries[0]?.isIntersecting === true;
+      if (isVisible && !loading && loadedKey !== `${filePath}:${pageIndex}`) {
+        void loadThumbnail();
+      } else if (!isVisible) {
+        coordinator.cancelActive();
+        loadedKey = "";
+        releaseCanvas();
+      }
+    }, { rootMargin: "200px" });
+    const resizeObserver = typeof ResizeObserver === "undefined" ? null : new ResizeObserver(() => {
+      if (isVisible && loadedKey && !loading) {
+        loadedKey = "";
+        coordinator.cancelActive();
+        void loadThumbnail();
+      }
+    });
+    if (container) {
+      observer.observe(container);
+      resizeObserver?.observe(container);
+    }
+    return () => {
+      mounted = false;
+      observer.disconnect();
+      resizeObserver?.disconnect();
+      coordinator.destroy();
+      releaseCanvas();
+    };
+  });
+
+  $effect(() => {
+    const nextKey = `${filePath}:${pageIndex}`;
+    if (!mounted || observedSourceKey === nextKey) return;
+    observedSourceKey = nextKey;
+    queueMicrotask(() => {
+      coordinator.cancelActive();
+      loadedKey = "";
+      releaseCanvas();
+      if (isVisible) void loadThumbnail();
+    });
+  });
+
+  async function loadThumbnail() {
+    const targetWidth = measuredTargetWidth();
+    if (!mounted || !isVisible || !canvas || targetWidth <= 0) return;
+    loading = true;
+    let requestSnapshot;
+    try {
+      const currentSession = renderSession.snapshot();
+      const session = requireActiveRenderSession(
+        renderSession,
+        filePath,
+        currentSession.generation,
+      );
+      const request = coordinator.begin({
+        path: filePath,
+        documentId: session.documentId,
+        pageIndex,
+        targetWidth,
+        generation: session.generation,
+      });
+      requestSnapshot = request.snapshot;
+      const rendered = validateRenderResponse(
+        await request.wait(renderThumbnail(requestSnapshot)),
+        requestSnapshot,
+      );
+      if (
+        !coordinator.isCurrent(requestSnapshot) ||
+        !mounted ||
+        !isVisible ||
+        filePath !== requestSnapshot.path ||
+        pageIndex !== requestSnapshot.pageIndex
+      ) {
+        return;
+      }
+      paintBufferToCanvas(canvas, rendered);
+      loadedKey = `${filePath}:${pageIndex}`;
+    } catch (err) {
+      if (!isExpectedRenderCancellation(err)) {
+        console.error("Thumbnail load error", err);
+      }
+    } finally {
+      if (requestSnapshot) coordinator.settle(requestSnapshot);
+      loading = false;
+    }
+  }
+</script>
+
+<div
+  bind:this={container}
+  class="thumbnail-container {isActive ? 'active' : ''}"
+  onclick={onSelect}
+  onkeydown={(event) => {
+    if (event.key === "Enter" || event.key === " ") onSelect();
+  }}
+  role="button"
+  tabindex="0"
+>
+  <canvas bind:this={canvas} aria-label="Page {pageIndex + 1}"></canvas>
+  {#if !loadedKey}
+    <div class="placeholder">
+      <span>{pageIndex + 1}</span>
+    </div>
+  {/if}
+  <div class="page-label">{pageIndex + 1}</div>
+</div>
+
+<style>
+  .thumbnail-container {
+    width: 100%;
+    aspect-ratio: 1 / 1.414;
+    background: #1e1e1e;
+    border: 2px solid transparent;
+    border-radius: 4px;
+    cursor: pointer;
