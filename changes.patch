+    if (!pdfRect || !pageWidth || !pageHeight) return { left: 0, top: 0, width: 0, height: 0 };
+    return {
+      left: (pdfRect.x / pageWidth) * 100,
+      top: ((pageHeight - pdfRect.y - pdfRect.height) / pageHeight) * 100,
