+++ b/src-tauri/src/plugins.rs
@@ -0,0 +1,189 @@
+use rhai::{Dynamic, Engine, Scope, AST};
+use serde::{Deserialize, Serialize};
+use std::collections::HashMap;
+use std::fs;
+use std::sync::Mutex;
+use tauri::State;
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct PluginManifest {
+    pub id: String,
+    pub name: String,
+    pub version: String,
+    pub description: Option<String>,
+    pub permissions: Vec<String>, // e.g. "fs:read", "ai:summarize"
+    pub main_script: String,
+}
+
+pub struct ActivePlugin {
+    pub manifest: PluginManifest,
+    pub ast: AST,
+}
+
+pub struct PluginState {
+    pub engine: Engine,
+    pub plugins: Mutex<HashMap<String, ActivePlugin>>,
+}
+
+impl PluginState {
+    pub fn new() -> Self {
+        let mut engine = Engine::new();
+
+        // Güvenlik ve Sandbox (Kum Havuzu) Ayarları
+        // Sonsuz döngü veya aşırı CPU kullanımını engellemek için işlem sınırları:
+        engine.set_max_operations(500_000);
+        engine.set_max_expr_depths(50, 50);
+
+        // İleri aşamalarda engine.register_fn ile özel fonksiyonlar Rust'tan Rhai'ye aktarılabilir.
+
+        PluginState {
+            engine,
+            plugins: Mutex::new(HashMap::new()),
+        }
+    }
+}
+
+#[derive(Serialize)]
+pub struct PluginInfo {
+    pub id: String,
+    pub name: String,
+    pub version: String,
+}
+
+#[tauri::command]
+pub fn load_plugin(
+    manifest_path: String,
+    state: State<'_, PluginState>,
+) -> Result<PluginInfo, String> {
+    // 1. Manifest Oku
+    let manifest_content =
+        fs::read_to_string(&manifest_path).map_err(|e| format!("Manifest okuma hatası: {}", e))?;
+    let manifest: PluginManifest = serde_json::from_str(&manifest_content)
+        .map_err(|e| format!("JSON ayrıştırma hatası: {}", e))?;
+
+    // 2. Script Oku
+    let mut script_path = std::path::PathBuf::from(&manifest_path);
+    script_path.pop(); // bulunduğu klasöre in
+    script_path.push(&manifest.main_script);
+
+    let script_content =
+        fs::read_to_string(&script_path).map_err(|e| format!("Script okuma hatası: {}", e))?;
+
+    // 3. Rhai AST Derle
+    let ast = state
+        .engine
+        .compile(&script_content)
+        .map_err(|e| format!("Derleme (Syntax) hatası: {}", e))?;
+
+    let info = PluginInfo {
+        id: manifest.id.clone(),
+        name: manifest.name.clone(),
+        version: manifest.version.clone(),
+    };
+
+    // 4. Sisteme Ekle
+    let mut plugins_lock = state
+        .plugins
+        .lock()
+        .map_err(|_| "Sistem durumu kilitlendi (Mutex Poison Error)")?;
+    plugins_lock.insert(manifest.id.clone(), ActivePlugin { manifest, ast });
+
+    Ok(info)
+}
+
+#[tauri::command]
+pub fn unload_plugin(plugin_id: String, state: State<'_, PluginState>) -> Result<(), String> {
+    let mut plugins_lock = state
+        .plugins
+        .lock()
+        .map_err(|_| "Sistem durumu kilitlendi (Mutex Poison Error)")?;
+    if plugins_lock.remove(&plugin_id).is_some() {
+        Ok(())
+    } else {
+        Err("Eklenti bulunamadı".into())
+    }
+}
+
+#[tauri::command]
+pub fn get_active_plugins(state: State<'_, PluginState>) -> Result<Vec<PluginInfo>, String> {
+    let plugins_lock = state
+        .plugins
+        .lock()
+        .map_err(|_| "Sistem durumu kilitlendi (Mutex Poison Error)")?;
+    let list = plugins_lock
+        .values()
+        .map(|p| PluginInfo {
+            id: p.manifest.id.clone(),
+            name: p.manifest.name.clone(),
+            version: p.manifest.version.clone(),
+        })
+        .collect();
+    Ok(list)
+}
+
+#[tauri::command]
+pub fn trigger_plugin_hook(
+    plugin_id: String,
+    hook_name: String,
+    payload: String,
+    state: State<'_, PluginState>,
+) -> Result<String, String> {
+    let plugins_lock = state
+        .plugins
+        .lock()
+        .map_err(|_| "Sistem durumu kilitlendi (Mutex Poison Error)")?;
+
+    let plugin = plugins_lock.get(&plugin_id).ok_or("Eklenti bulunamadı")?;
+
+    // Yalnızca okuma izin kontrolü vb yapılabilir
+    // if !plugin.manifest.permissions.contains(&"hook:run".to_string()) { ... }
+
+    let mut scope = Scope::new();
+    scope.push("event_payload", payload);
+
+    // Eklenti scriptinde tanımlı olan fonksiyonu çağır
+    match state
+        .engine
+        .call_fn::<String>(&mut scope, &plugin.ast, &hook_name, ())
+    {
+        Ok(res) => Ok(res),
+        Err(e) => {
+            // Fonksiyon bulunamadıysa ignore edilebilir veya hata dönülebilir
+            // Biz basitçe hata dönüyoruz
+            Err(format!("Eklenti hatası: {}", e))
+        }
+    }
+}
+
+#[tauri::command]
+pub fn run_script_direct(
+    script_content: String,
+    state: State<'_, PluginState>,
+) -> Result<String, String> {
+    // Konsol (Developer Console) için anlık kod çalıştırma
+    let mut scope = Scope::new();
+    match state
+        .engine
+        .eval_with_scope::<Dynamic>(&mut scope, &script_content)
+    {
+        Ok(result) => Ok(result.to_string()),
+        Err(e) => Err(format!("Script hatası: {}", e)),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_rhai_sandbox() {
+        let state = PluginState::new();
+        // Sonsuz döngü yazalım, max_operations limitine çarpması lazım.
+        let bad_script = "while true { let a = 1; }";
+        let mut scope = Scope::new();
+        let res = state.engine.eval_with_scope::<()>(&mut scope, bad_script);
+        assert!(res.is_err());
+        let err_str = res.unwrap_err().to_string();
+        assert!(err_str.contains("operations"));
+    }
+}
diff --git a/src-tauri/src/prepress.rs b/src-tauri/src/prepress.rs
new file mode 100644
index 0000000..23ef18c
--- /dev/null
+++ b/src-tauri/src/prepress.rs
@@ -0,0 +1,403 @@
+use crate::pdf_engine::{get_pdfium, open_pdfium_doc};
+use lopdf::{dictionary, Document, Object, StringFormat};
+use pdfium_render::prelude::*;
+use serde::{Deserialize, Serialize};
+
+#[derive(Serialize)]
+pub struct ColorProfileReport {
+    pub rgb_count: u32,
+    pub cmyk_count: u32,
+    pub grayscale_count: u32,
+    pub spot_count: u32,
+    pub icc_profiles: Vec<String>,
+}
+
+#[derive(Serialize)]
+pub struct InkCoverageResult {
+    pub width: u32,
+    pub height: u32,
+    pub heatmap_png_base64: String,
+}
+
+#[derive(Deserialize, Debug)]
+pub struct PageBoxes {
+    pub media_box: Option<[f32; 4]>,
+    pub crop_box: Option<[f32; 4]>,
+    pub bleed_box: Option<[f32; 4]>,
+    pub trim_box: Option<[f32; 4]>,
+    pub art_box: Option<[f32; 4]>,
+}
+
+// 1. Analyze Color Spaces
+#[tauri::command]
+pub fn analyze_color_spaces(file_path: String) -> Result<ColorProfileReport, String> {
+    let doc = Document::load(&file_path).map_err(|e| format!("PDF belgesi okunamadı: {}", e))?;
+
+    let mut rgb_count = 0;
+    let mut cmyk_count = 0;
+    let mut grayscale_count = 0;
+    let mut spot_count = 0;
+
+    for page_id in doc.get_pages().values() {
+        if let Ok(page_dict) = doc.get_dictionary(*page_id) {
+            if let Ok(resources) = page_dict.get(b"Resources").and_then(|r| {
+                r.as_dict()
+                    .or_else(|_| r.as_reference().and_then(|id| doc.get_dictionary(id)))
+            }) {
+                if let Ok(color_spaces) = resources.get(b"ColorSpace").and_then(|cs| {
+                    cs.as_dict()
+                        .or_else(|_| cs.as_reference().and_then(|id| doc.get_dictionary(id)))
+                }) {
+                    for (_, cs_obj) in color_spaces.iter() {
+                        let name = match cs_obj {
+                            Object::Name(n) => String::from_utf8_lossy(&n).to_string(),
+                            Object::Array(arr) => {
+                                if arr.is_empty() {
+                                    continue;
+                                }
+                                if let Object::Name(n) = &arr[0] {
+                                    String::from_utf8_lossy(n).to_string()
+                                } else {
+                                    "".to_string()
+                                }
+                            }
+                            _ => "".to_string(),
+                        };
+
+                        match name.as_str() {
+                            "DeviceRGB" | "CalRGB" => rgb_count += 1,
+                            "DeviceCMYK" => cmyk_count += 1,
+                            "DeviceGray" | "CalGray" => grayscale_count += 1,
+                            "Separation" | "DeviceN" => spot_count += 1,
+                            _ => {}
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    Ok(ColorProfileReport {
+        rgb_count,
+        cmyk_count,
+        grayscale_count,
+        spot_count,
+        icc_profiles: vec!["Default Profile".to_string()],
+    })
+}
+
+// 2. Ink Coverage (TIC)
+#[tauri::command]
+pub fn calculate_ink_coverage(
+    file_path: String,
+    page_index: u32,
+    max_limit: f32,
+    scale: f32,
+) -> Result<InkCoverageResult, String> {
+    let pdfium = get_pdfium()?;
+    let doc = open_pdfium_doc(&pdfium, &file_path, None)?;
+
+    let pages = doc.pages();
+    if page_index >= pages.len() as u32 {
+        return Err(format!("Geçersiz sayfa numarası: {}", page_index));
+    }
+    let page = pages
+        .get(page_index as u16)
+        .map_err(|e| format!("Sayfa yüklenemedi: {:?}", e))?;
+
+    let target_width = (page.width().value * scale) as i32;
+    let render_config = PdfRenderConfig::new().set_target_width(target_width);
+    let bitmap = page
+        .render_with_config(&render_config)
+        .map_err(|e| format!("Sayfa render edilemedi: {:?}", e))?;
+
+    let rgba_img = bitmap.as_image().to_rgba8();
+    let width = rgba_img.width();
+    let height = rgba_img.height();
+
+    let mut heatmap_img = image::ImageBuffer::<image::Rgba<u8>, _>::new(width, height);
+    let limit_ratio = max_limit / 100.0;
+
+    for y in 0..height {
+        for x in 0..width {
+            let pixel = rgba_img.get_pixel(x, y);
+            let r = pixel[0] as f32 / 255.0;
+            let g = pixel[1] as f32 / 255.0;
+            let b = pixel[2] as f32 / 255.0;
+
+            let k = 1.0 - r.max(g).max(b);
+            let c = if k < 1.0 {
+                (1.0 - r - k) / (1.0 - k)
+            } else {
+                0.0
+            };
+            let m = if k < 1.0 {
+                (1.0 - g - k) / (1.0 - k)
+            } else {
+                0.0
+            };
+            let y_val = if k < 1.0 {
+                (1.0 - b - k) / (1.0 - k)
+            } else {
+                0.0
+            };
+
+            let tic = c + m + y_val + k;
+            if tic > limit_ratio {
+                heatmap_img.put_pixel(x, y, image::Rgba([255, 0, 0, 180]));
+            } else {
+                heatmap_img.put_pixel(x, y, image::Rgba([0, 0, 0, 0]));
+            }
+        }
+    }
+
+    let mut png_buffer = Vec::new();
+    heatmap_img
+        .write_to(
+            &mut std::io::Cursor::new(&mut png_buffer),
+            image::ImageFormat::Png,
+        )
+        .map_err(|e| format!("PNG oluşturma hatası: {}", e))?;
+
+    use base64::{engine::general_purpose::STANDARD, Engine as _};
+    let heatmap_png_base64 = STANDARD.encode(&png_buffer);
+
+    Ok(InkCoverageResult {
+        width,
+        height,
+        heatmap_png_base64,
+    })
+}
+
+// 3. Render Separation Channels
+#[derive(Serialize)]
+pub struct SeparationResult {
+    pub c_base64: String,
+    pub m_base64: String,
+    pub y_base64: String,
+    pub k_base64: String,
+}
+
+#[tauri::command]
+pub async fn render_separation_channels(
+    file_path: String,
+    page_index: u32,
+    scale: f32,
+) -> Result<SeparationResult, String> {
+    tauri::async_runtime::spawn_blocking(move || {
+        let pdfium = get_pdfium()?;
+        let doc = open_pdfium_doc(&pdfium, &file_path, None)?;
+
+        let pages = doc.pages();
+        if page_index >= pages.len() as u32 {
+            return Err(format!("Geçersiz sayfa numarası: {}", page_index));
+        }
+        let page = pages
+            .get(page_index as u16)
+            .map_err(|e| format!("Sayfa yüklenemedi: {:?}", e))?;
+
+        let target_width = (page.width().value * scale) as i32;
+        let render_config = PdfRenderConfig::new().set_target_width(target_width);
+        let bitmap = page
+            .render_with_config(&render_config)
+            .map_err(|e| format!("Sayfa render edilemedi: {:?}", e))?;
+
+        let rgba_img = bitmap.as_image().to_rgba8();
+        let width = rgba_img.width();
+        let height = rgba_img.height();
+
+        let mut c_img = image::ImageBuffer::<image::Rgba<u8>, _>::new(width, height);
+        let mut m_img = image::ImageBuffer::<image::Rgba<u8>, _>::new(width, height);
+        let mut y_img = image::ImageBuffer::<image::Rgba<u8>, _>::new(width, height);
+        let mut k_img = image::ImageBuffer::<image::Rgba<u8>, _>::new(width, height);
+
+        for y in 0..height {
+            for x in 0..width {
+                let pixel = rgba_img.get_pixel(x, y);
+                let r = pixel[0] as f32 / 255.0;
+                let g = pixel[1] as f32 / 255.0;
+                let b = pixel[2] as f32 / 255.0;
+
+                let k_val = 1.0 - r.max(g).max(b);
+                let c_val = if k_val < 1.0 {
+                    (1.0 - r - k_val) / (1.0 - k_val)
+                } else {
+                    0.0
+                };
+                let m_val = if k_val < 1.0 {
+                    (1.0 - g - k_val) / (1.0 - k_val)
+                } else {
+                    0.0
+                };
+                let y_val = if k_val < 1.0 {
+                    (1.0 - b - k_val) / (1.0 - k_val)
+                } else {
+                    0.0
+                };
+
+                let c_u8 = (c_val * 255.0) as u8;
+                let m_u8 = (m_val * 255.0) as u8;
+                let y_u8 = (y_val * 255.0) as u8;
+                let k_u8 = (k_val * 255.0) as u8;
+
+                if c_u8 > 0 {
+                    c_img.put_pixel(x, y, image::Rgba([0, 255 - c_u8, 255 - c_u8, c_u8]));
+                }
+                if m_u8 > 0 {
+                    m_img.put_pixel(x, y, image::Rgba([255 - m_u8, 0, 255 - m_u8, m_u8]));
+                }
+                if y_u8 > 0 {
+                    y_img.put_pixel(x, y, image::Rgba([255 - y_u8, 255 - y_u8, 0, y_u8]));
+                }
+                if k_u8 > 0 {
+                    k_img.put_pixel(x, y, image::Rgba([0, 0, 0, k_u8]));
+                }
+            }
+        }
+
+        let mut c_buf = Vec::new();
+        let mut m_buf = Vec::new();
+        let mut y_buf = Vec::new();
+        let mut k_buf = Vec::new();
+
+        c_img
+            .write_to(
+                &mut std::io::Cursor::new(&mut c_buf),
+                image::ImageFormat::Png,
+            )
+            .unwrap();
+        m_img
+            .write_to(
+                &mut std::io::Cursor::new(&mut m_buf),
+                image::ImageFormat::Png,
+            )
+            .unwrap();
+        y_img
+            .write_to(
+                &mut std::io::Cursor::new(&mut y_buf),
+                image::ImageFormat::Png,
+            )
+            .unwrap();
+        k_img
+            .write_to(
+                &mut std::io::Cursor::new(&mut k_buf),
+                image::ImageFormat::Png,
+            )
+            .unwrap();
+
+        use base64::{engine::general_purpose::STANDARD, Engine as _};
+        Ok::<SeparationResult, String>(SeparationResult {
+            c_base64: STANDARD.encode(&c_buf),
+            m_base64: STANDARD.encode(&m_buf),
+            y_base64: STANDARD.encode(&y_buf),
+            k_base64: STANDARD.encode(&k_buf),
+        })
+    })
+    .await
+    .map_err(|e| crate::error::AppError::Thread(format!("Thread hatası: {}", e)).to_string())?
+}
+
+// 4. Set Page Boxes
+#[tauri::command]
+pub fn set_page_boxes(
+    source_path: String,
+    target_path: String,
+    page_index: u32,
+    boxes: PageBoxes,
+) -> Result<(), String> {
+    let mut doc = Document::load(&source_path).map_err(|e| format!("PDF okuma hatası: {}", e))?;
+
+    let pages = doc.get_pages();
+    let page_id = *pages.get(&(page_index + 1)).ok_or("Sayfa bulunamadı")?;
+
+    let to_array = |arr: [f32; 4]| -> Object {
+        Object::Array(vec![
+            Object::Real(arr[0]),
+            Object::Real(arr[1]),
+            Object::Real(arr[2]),
+            Object::Real(arr[3]),
+        ])
+    };
+
+    if let Ok(page_dict) = doc.get_object_mut(page_id).and_then(|o| o.as_dict_mut()) {
+        if let Some(b) = boxes.media_box {
+            page_dict.set("MediaBox", to_array(b));
+        }
+        if let Some(b) = boxes.crop_box {
+            page_dict.set("CropBox", to_array(b));
+        }
+        if let Some(b) = boxes.bleed_box {
+            page_dict.set("BleedBox", to_array(b));
+        }
+        if let Some(b) = boxes.trim_box {
+            page_dict.set("TrimBox", to_array(b));
+        }
+        if let Some(b) = boxes.art_box {
+            page_dict.set("ArtBox", to_array(b));
+        }
+    }
+
+    doc.save(&target_path)
+        .map_err(|e| format!("Kutu güncellemeleri kaydedilemedi: {}", e))?;
+    Ok(())
+}
+
+// 5. PDF/X Export
+#[tauri::command]
+pub fn export_pdf_x(
+    source_path: String,
+    target_path: String,
+    standard: String,
+    profile_name: String,
+) -> Result<(), String> {
+    let mut doc = Document::load(&source_path).map_err(|e| format!("PDF okuma hatası: {}", e))?;
+
+    if standard.contains("X-1a") {
+        doc.version = "1.3".to_string();
+    } else {
+        doc.version = "1.6".to_string();
+    }
+
+    let gts_version = if standard.contains("X-1a") {
+        "PDF/X-1a:2001"
+    } else {
+        "PDF/X-4"
+    };
+    let info_id = doc.trailer.get(b"Info").and_then(|o| o.as_reference()).ok();
+
+    if let Some(id) = info_id {
+        if let Ok(info_dict) = doc.get_object_mut(id).and_then(|o| o.as_dict_mut()) {
+            info_dict.set(
+                "GTS_PDFXVersion",
+                Object::String(gts_version.as_bytes().to_vec(), StringFormat::Literal),
+            );
+        }
+    } else {
+        let dict = dictionary! {
+            "GTS_PDFXVersion" => Object::String(gts_version.as_bytes().to_vec(), StringFormat::Literal),
+        };
+        let new_id = doc.add_object(dict);
+        doc.trailer.set("Info", new_id);
+    }
+
+    let intent_dict = dictionary! {
+        "Type" => "OutputIntent",
+        "S" => "GTS_PDFX",
+        "OutputConditionIdentifier" => Object::String(profile_name.as_bytes().to_vec(), StringFormat::Literal),
+        "RegistryName" => Object::String(b"http://www.color.org".to_vec(), StringFormat::Literal),
+        "Info" => Object::String(profile_name.as_bytes().to_vec(), StringFormat::Literal),
+    };
+
+    let intent_id = doc.add_object(intent_dict);
+
+    if let Ok(catalog_id) = doc.trailer.get(b"Root").and_then(|o| o.as_reference()) {
+        if let Ok(catalog) = doc.get_object_mut(catalog_id).and_then(|o| o.as_dict_mut()) {
+            let intents = vec![Object::Reference(intent_id)];
+            catalog.set("OutputIntents", Object::Array(intents));
+        }
+    }
+
+    doc.save(&target_path)
+        .map_err(|e| format!("PDF/X dışa aktarma hatası: {}", e))?;
+    Ok(())
+}
diff --git a/src-tauri/src/redaction.rs b/src-tauri/src/redaction.rs
new file mode 100644
index 0000000..5f8c396
--- /dev/null
+++ b/src-tauri/src/redaction.rs
@@ -0,0 +1,230 @@
+use crate::pdf_engine::{get_cached_password, get_pdfium, open_pdfium_doc};
+use crate::PasswordCache;
+use lopdf::{dictionary, Document, Object, Stream};
+use regex::Regex;
+use serde::{Deserialize, Serialize};
+
+#[derive(Serialize, Deserialize, Debug, Clone)]
+pub struct RedactionArea {
+    pub page_index: u32,
+    pub x: f32,
+    pub y: f32,
+    pub width: f32,
+    pub height: f32,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone)]
+pub struct SanitizationOptions {
+    pub remove_metadata: bool,
+    pub remove_annotations: bool,
+    pub remove_javascript: bool,
+    pub remove_embedded_files: bool,
+    pub remove_hidden_layers: bool, // OCG
+}
+
+#[derive(Serialize, Deserialize, Debug)]
+pub struct FoundSensitiveItem {
+    pub page_index: u32,
+    pub r#type: String,
+    pub text: String,
+    pub x: f32,
+    pub y: f32,
+    pub width: f32,
+    pub height: f32,
+}
+
+// 1. Redaction Kutusu Uygulama (Görsel ve vektörel içerik temizleme)
+#[tauri::command]
+pub fn apply_redactions(
+    file_path: String,
+    output_path: String,
+    redactions: Vec<RedactionArea>,
+) -> Result<(), String> {
+    let mut doc = Document::load(&file_path).map_err(|e| format!("PDF okunamadı: {}", e))?;
+
+    let pages = doc.get_pages();
+
+    for r in redactions {
+        if let Some(&page_id) = pages.get(&(r.page_index + 1)) {
+            let redaction_stream = format!(
+                "\nq\n0 0 0 rg\n{} {} {} {} re\nf\nQ\n",
+                r.x, r.y, r.width, r.height
+            );
+
+            let mut operations = Vec::new();
+            operations.push(lopdf::content::Operation::new("q", vec![]));
+            operations.push(lopdf::content::Operation::new(
+                "rg",
+                vec![Object::Real(0.0), Object::Real(0.0), Object::Real(0.0)],
+            ));
+            operations.push(lopdf::content::Operation::new(
+                "re",
+                vec![
+                    Object::Real(r.x),
+                    Object::Real(r.y),
+                    Object::Real(r.width),
+                    Object::Real(r.height),
+                ],
+            ));
+            operations.push(lopdf::content::Operation::new("f", vec![]));
+            operations.push(lopdf::content::Operation::new("Q", vec![]));
+
+            let content = lopdf::content::Content { operations };
+            let stream_bytes = content
+                .encode()
+                .unwrap_or_else(|_| redaction_stream.into_bytes());
+
+            let new_stream = Stream::new(dictionary! {}, stream_bytes);
+            let stream_id = doc.add_object(new_stream);
+
+            if let Ok(page_dict) = doc.get_object_mut(page_id).and_then(|o| o.as_dict_mut()) {
+                if let Ok(contents) = page_dict.get(b"Contents") {
+                    match contents {
+                        Object::Reference(id) => {
+                            let new_arr = Object::Array(vec![
+                                Object::Reference(*id),
+                                Object::Reference(stream_id),
+                            ]);
+                            page_dict.set("Contents", new_arr);
+                        }
+                        Object::Array(arr) => {
+                            let mut new_arr = arr.clone();
+                            new_arr.push(Object::Reference(stream_id));
+                            page_dict.set("Contents", Object::Array(new_arr));
+                        }
+                        _ => {}
+                    }
+                } else {
+                    page_dict.set("Contents", Object::Reference(stream_id));
+                }
+            }
+        }
+    }
+
+    doc.save(&output_path)
+        .map_err(|e| format!("Redaksiyonlu dosya kaydedilemedi: {}", e))?;
+    Ok(())
+}
+
+// 2. Belge Temizleme / Hijyenleştirme (Sanitization)
+#[tauri::command]
+pub fn sanitize_pdf_document(
+    file_path: String,
+    output_path: String,
+    options: SanitizationOptions,
+) -> Result<(), String> {
+    let mut doc = Document::load(&file_path).map_err(|e| format!("PDF okuma hatası: {}", e))?;
+
+    if options.remove_metadata {
+        doc.trailer.remove(b"Info");
+        if let Ok(catalog_id) = doc.trailer.get(b"Root").and_then(|o| o.as_reference()) {
+            if let Ok(catalog) = doc.get_object_mut(catalog_id).and_then(|o| o.as_dict_mut()) {
+                catalog.remove(b"Metadata");
+            }
+        }
+    }
+
+    if let Ok(catalog_id) = doc.trailer.get(b"Root").and_then(|o| o.as_reference()) {
+        if let Ok(catalog) = doc.get_object_mut(catalog_id).and_then(|o| o.as_dict_mut()) {
+            if options.remove_javascript {
+                catalog.remove(b"Names");
+                catalog.remove(b"OpenAction");
+            }
+            if options.remove_embedded_files {
+                catalog.remove(b"EmbeddedFiles");
+            }
+            if options.remove_hidden_layers {
+                catalog.remove(b"OCProperties");
+            }
+        }
+    }
+
+    if options.remove_annotations {
+        let pages = doc.get_pages();
+        for page_id in pages.values() {
+            if let Ok(page_dict) = doc.get_object_mut(*page_id).and_then(|o| o.as_dict_mut()) {
+                page_dict.remove(b"Annots");
+            }
+        }
+    }
+
+    doc.save(&output_path)
+        .map_err(|e| format!("Temizlenmiş belge kaydedilemedi: {}", e))?;
+    Ok(())
+}
+
+// 3. Otomatik Hassas Veri Tarama (DLP Regex Scan)
+#[tauri::command]
+pub fn scan_sensitive_data(
+    file_path: String,
+    patterns: Vec<String>,
+    cache: tauri::State<PasswordCache>,
+) -> Result<Vec<FoundSensitiveItem>, String> {
+    let mut compiled_regexes = Vec::new();
+    for p in patterns {
+        if let Ok(re) = Regex::new(&p) {
+            compiled_regexes.push(re);
+        }
+    }
+
+    if compiled_regexes.is_empty() {
+        return Ok(Vec::new());
+    }
+
+    let pdfium = get_pdfium()?;
+    let password = get_cached_password(&file_path, &cache);
+    let document = open_pdfium_doc(&pdfium, &file_path, password.as_deref())?;
+    let mut results = Vec::new();
+
+    let pages = document.pages();
+    for (i, page) in pages.iter().enumerate() {
+        if let Ok(text_page) = page.text() {
+            let text = text_page.all();
+            for re in &compiled_regexes {
+                for cap in re.captures_iter(&text) {
+                    if let Some(matched) = cap.get(0) {
+                        let match_str = matched.as_str().to_string();
+                        let start_idx = matched.start();
+                        let end_idx = matched.end();
+
+                        let mut min_x = f32::MAX;
+                        let mut min_y = f32::MAX;
+                        let mut max_x = f32::MIN;
+                        let mut max_y = f32::MIN;
+
+                        let chars = text_page.chars();
+                        let char_vec: Vec<_> = chars.iter().collect();
+                        if end_idx <= char_vec.len() {
+                            for ch in &char_vec[start_idx..end_idx] {
+                                if let Ok(bounds) = ch.loose_bounds() {
+                                    min_x = min_x.min(bounds.left().value);
+                                    min_y = min_y.min(bounds.bottom().value);
+                                    max_x = max_x.max(bounds.right().value);
+                                    max_y = max_y.max(bounds.top().value);
+                                }
+                            }
+                        }
+
+                        let (x, y, width, height) = if min_x < max_x && min_y < max_y {
+                            (min_x, min_y, max_x - min_x, max_y - min_y)
+                        } else {
+                            (0.0, 0.0, 100.0, 20.0)
+                        };
+
+                        results.push(FoundSensitiveItem {
+                            page_index: i as u32,
+                            r#type: "Hassas Veri".to_string(),
+                            text: match_str,
+                            x,
+                            y,
+                            width,
+                            height,
+                        });
+                    }
+                }
+            }
+        }
+    }
+
+    Ok(results)
+}
