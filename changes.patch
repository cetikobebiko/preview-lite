diff --git a/src-tauri/src/worker/pdfium.rs b/src-tauri/src/worker/pdfium.rs
new file mode 100644
index 0000000..ec6971f
--- /dev/null
+++ b/src-tauri/src/worker/pdfium.rs
@@ -0,0 +1,233 @@
+use crate::worker::ipc::{WorkerCommand, WorkerResponse};
+use crate::TextLayoutData;
+use pdfium_render::prelude::*;
+use std::collections::HashMap;
+use std::io::{Read, Write};
+
+pub fn run_worker() {
+    #[cfg(feature = "tracy")]
+    {
+        use tracing_subscriber::prelude::*;
+        let registry = tracing_subscriber::registry().with(tracing_tracy::TracyLayer::default());
+        let _ = registry.try_init();
+        tracy_client::set_thread_name!("Worker_Main");
+    }
+    // OS Level limits (Linux/Mac via libc, Windows via Job Objects could be added here)
+    #[cfg(target_family = "unix")]
+    unsafe {
+        let rlim = libc::rlimit {
+            rlim_cur: 1024 * 1024 * 512, // 512 MB
+            rlim_max: 1024 * 1024 * 512,
+        };
+        let _ = libc::setrlimit(libc::RLIMIT_AS, &rlim);
+    }
+
+    let bind = Pdfium::bind_to_system_library()
+        .or_else(|_| Pdfium::bind_to_library(Pdfium::pdfium_platform_library_name_at_path("./")));
+
+    let pdfium = match bind {
+        Ok(b) => Pdfium::new(b),
+        Err(e) => {
+            send_response(&WorkerResponse::Error(format!(
+                "PDFium Init Error: {:?}",
+                e
+            )));
+            return;
+        }
+    };
+
+    let mut documents: HashMap<u64, PdfDocument> = HashMap::new();
+    let mut next_doc_id = 1;
+
+    loop {
+        let mut len_buf = [0u8; 4];
+        if std::io::stdin().read_exact(&mut len_buf).is_err() {
+            break; // pipe closed
+        }
+        let len = u32::from_le_bytes(len_buf) as usize;
+        let mut data_buf = vec![0u8; len];
+        if std::io::stdin().read_exact(&mut data_buf).is_err() {
+            break;
+        }
+
+        let cmd: WorkerCommand = match bincode::deserialize(&data_buf) {
+            Ok(c) => c,
+            Err(_) => break, // invalid data
+        };
+
+        match cmd {
+            WorkerCommand::Ping => {
+                send_response(&WorkerResponse::Pong);
+            }
+            WorkerCommand::LoadDocument { path, password } => {
+                let _span = tracing::info_span!("Worker_LoadDocument", path = %path).entered();
+                let pwd_ref: Option<&'static str> =
+                    password.map(|pw| Box::leak(pw.into_boxed_str()) as &'static str);
+
+                let ffi_res = {
+                    let _ffi_span =
+                        tracing::info_span!(target: "pdfium_ffi", "pdfium_load_pdf").entered();
+                    pdfium.load_pdf_from_file(&path, pwd_ref)
+                };
+
+                match ffi_res {
+                    Ok(doc) => {
+                        let doc_id = next_doc_id;
+                        next_doc_id += 1;
+                        let page_count = doc.pages().len() as u32;
+                        documents.insert(doc_id, doc);
+                        send_response(&WorkerResponse::DocumentLoaded {
+                            document_id: doc_id,
+                            page_count,
+                        });
+                    }
+                    Err(e) => send_response(&WorkerResponse::Error(e.to_string())),
+                }
+            }
+            WorkerCommand::RenderPage {
+                document_id,
+                page_index,
+                scale,
+            } => {
+                let _span = tracing::info_span!(
+                    "Worker_RenderPage",
+                    doc = document_id,
+                    page = page_index,
+                    scale = scale
+                )
+                .entered();
+                if let Some(doc) = documents.get(&document_id) {
+                    match doc.pages().get(page_index as u16) {
+                        Ok(page) => {
+                            let width_pixels = (page.width().value * scale) as i32;
+                            let render_cfg = PdfRenderConfig::new()
+                                .set_target_width(width_pixels)
+                                .set_clear_color(PdfColor::WHITE);
+
+                            let render_res = {
+                                let _ffi_span =
+                                    tracing::info_span!(target: "pdfium_ffi", "pdfium_render_page")
+                                        .entered();
+                                page.render_with_config(&render_cfg)
+                            };
+
+                            match render_res {
+                                Ok(bitmap) => {
+                                    send_response(&WorkerResponse::PageRendered {
+                                        width: bitmap.width() as u32,
+                                        height: bitmap.height() as u32,
+                                        data: bitmap.as_raw_bytes().to_vec(),
+                                    });
+                                }
+                                Err(e) => send_response(&WorkerResponse::Error(e.to_string())),
+                            }
+                        }
+                        Err(e) => send_response(&WorkerResponse::Error(e.to_string())),
+                    }
+                } else {
+                    send_response(&WorkerResponse::Error("Document not found".to_string()));
+                }
+            }
+            WorkerCommand::GetPageTextLayout {
+                document_id,
+                page_index,
+            } => {
+                let _span = tracing::info_span!(
+                    "Worker_GetPageTextLayout",
+                    doc = document_id,
+                    page = page_index
+                )
+                .entered();
+                if let Some(doc) = documents.get(&document_id) {
+                    if let Ok(page) = doc.pages().get(page_index as u16) {
+                        let text_page_res = {
+                            let _ffi_span =
+                                tracing::info_span!(target: "pdfium_ffi", "pdfium_get_text")
+                                    .entered();
+                            page.text()
+                        };
+                        if let Ok(text_page) = text_page_res {
+                            let _layout_span =
+                                tracing::info_span!("Worker_ExtractLayout").entered();
+                            let page_width = page.width().value;
+                            let page_height = page.height().value;
+
+                            let mut current_line_text = String::new();
+                            let mut min_x = f32::MAX;
+                            let mut min_y = f32::MAX;
+                            let mut max_x = f32::MIN;
+                            let mut max_y = f32::MIN;
+
+                            let mut layouts = Vec::new();
+                            let chars = text_page.chars();
+                            for ch in chars.iter() {
+                                let c = ch.unicode_char().unwrap_or(' ');
+                                if c == '\n' || c == '\r' {
+                                    if !current_line_text.is_empty()
+                                        && min_x < max_x
+                                        && min_y < max_y
+                                    {
+                                        layouts.push(TextLayoutData {
+                                            x: min_x / page_width,
+                                            y: (page_height - max_y) / page_height,
+                                            width: (max_x - min_x) / page_width,
+                                            height: (max_y - min_y) / page_height,
+                                            text: current_line_text.clone(),
+                                        });
+                                        current_line_text.clear();
+                                        min_x = f32::MAX;
+                                        min_y = f32::MAX;
+                                        max_x = f32::MIN;
+                                        max_y = f32::MIN;
+                                    }
+                                    continue;
+                                }
+
+                                current_line_text.push(c);
+                                if let Ok(bounds) = ch.loose_bounds() {
+                                    min_x = min_x.min(bounds.left().value);
+                                    min_y = min_y.min(bounds.bottom().value);
+                                    max_x = max_x.max(bounds.right().value);
+                                    max_y = max_y.max(bounds.top().value);
+                                }
+                            }
+
+                            if !current_line_text.is_empty() && min_x < max_x && min_y < max_y {
+                                layouts.push(TextLayoutData {
+                                    x: min_x / page_width,
+                                    y: (page_height - max_y) / page_height,
+                                    width: (max_x - min_x) / page_width,
+                                    height: (max_y - min_y) / page_height,
+                                    text: current_line_text,
+                                });
+                            }
+
+                            send_response(&WorkerResponse::TextLayout(layouts));
+                        } else {
+                            send_response(&WorkerResponse::Error(
+                                "Text extraction failed".to_string(),
+                            ));
+                        }
+                    } else {
+                        send_response(&WorkerResponse::Error("Page not found".to_string()));
+                    }
+                } else {
+                    send_response(&WorkerResponse::Error("Document not found".to_string()));
+                }
+            }
+            WorkerCommand::CloseDocument { document_id } => {
+                documents.remove(&document_id);
+                send_response(&WorkerResponse::Ok);
+            }
+        }
+    }
+}
+
+fn send_response(res: &WorkerResponse) {
+    let data = bincode::serialize(res).unwrap();
+    let len = (data.len() as u32).to_le_bytes();
+    let mut stdout = std::io::stdout();
+    let _ = stdout.write_all(&len);
+    let _ = stdout.write_all(&data);
+    let _ = stdout.flush();
+}
