+        isScanning = true;
+        foundItems = [];
+        
+        const activePatterns = patterns.filter(p => p.active).map(p => p.regex);
+        
+        try {
+            const results = await scanSensitiveDataAction(
+                pdfPath,
+                activePatterns,
+                featureContext,
+            );
+            foundItems = results;
+        } catch (error) {
+            console.error("Tarama hatası:", error);
