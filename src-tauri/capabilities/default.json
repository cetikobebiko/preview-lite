{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:allow-open",
    "fs:allow-appdata-read",
    "fs:allow-appdata-write",
    "fs:allow-read",
    "fs:allow-write"
  ]
}
