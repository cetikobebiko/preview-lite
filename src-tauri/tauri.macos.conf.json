{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Preview Lite",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "visible": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 20
        }
      }
    ]
  },
  "bundle": {
    "targets": [
      "dmg",
      "app"
    ],
    "resources": [
      "lib/libpdfium.dylib"
    ],
    "externalBin": [
      "binaries/antigravity-macos-helper"
    ]
  }
}
