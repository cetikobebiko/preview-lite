diff --git a/core/fxge/cfx_font.cpp b/core/fxge/cfx_font.cpp
index 04aec88..8e09145 100644
--- a/core/fxge/cfx_font.cpp
+++ b/core/fxge/cfx_font.cpp
@@ -130,6 +130,11 @@ FX_Charset CFX_Font::GetCharSetFromUnicode(uint16_t word) {
     return FX_Charset::kMSWin_Cyrillic;
   }
 
+  // Turkish letters that Windows-1250 lacks but Windows-1254 has.
+  if (word == 0x011E || word == 0x011F || word == 0x0130 || word == 0x0131) {
+    return FX_Charset::kMSWin_Turkish;
+  }
+
   if (word >= 0x0100 && word <= 0x024F) {
     return FX_Charset::kMSWin_EasternEuropean;
   }
diff --git a/core/fxge/cfx_font_unittest.cpp b/core/fxge/cfx_font_unittest.cpp
index 61f6fbf..ce8b965 100644
--- a/core/fxge/cfx_font_unittest.cpp
