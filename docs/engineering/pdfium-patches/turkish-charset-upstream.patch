@@ -7,6 +7,7 @@
 #include <string>
 #include <vector>
 
+#include "core/fxcrt/fx_codepage.h"
 #include "core/fxge/cfx_cttgsubtable.h"
 #include "testing/gtest/include/gtest/gtest.h"
 #include "testing/utils/file_util.h"
@@ -71,3 +72,25 @@ TEST(CfxFontTest, ParseGSUBTable) {
   EXPECT_EQ(10u, sc_gsub->GetVerticalGlyph(2));
   EXPECT_EQ(0u, sc_gsub->GetVerticalGlyph(3));
 }
+
+TEST(CfxFontTest, GetCharSetFromUnicodeLatinExtendedA) {
+  // G with breve, g with breve, I with dot above and dotless i are in
+  // Windows-1254 but not in Windows-1250.
+  EXPECT_EQ(FX_Charset::kMSWin_Turkish,
+            CFX_Font::GetCharSetFromUnicode(0x011E));
+  EXPECT_EQ(FX_Charset::kMSWin_Turkish,
+            CFX_Font::GetCharSetFromUnicode(0x011F));
+  EXPECT_EQ(FX_Charset::kMSWin_Turkish,
+            CFX_Font::GetCharSetFromUnicode(0x0130));
+  EXPECT_EQ(FX_Charset::kMSWin_Turkish,
+            CFX_Font::GetCharSetFromUnicode(0x0131));
+
+  // The rest of Latin Extended-A stays Eastern European, including the
+  // Turkish S with cedilla that Windows-1250 also has.
+  EXPECT_EQ(FX_Charset::kMSWin_EasternEuropean,
+            CFX_Font::GetCharSetFromUnicode(0x0105));
+  EXPECT_EQ(FX_Charset::kMSWin_EasternEuropean,
+            CFX_Font::GetCharSetFromUnicode(0x015E));
+  EXPECT_EQ(FX_Charset::kMSWin_EasternEuropean,
+            CFX_Font::GetCharSetFromUnicode(0x015F));
+}
